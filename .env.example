# Copia este archivo como .env y rellena los valores. Nunca subas .env a git.

DATABASE_URL=
PORT=3000
BASE_URL=https://rentmeuskar.com

# Firma de sesiones (cadena aleatoria larga). Sin ella las sesiones caducan al reiniciar.
SESSION_SECRET=

# Acceso al panel de administración (solo se usa si no se han cambiado desde el panel)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Correo opcional con el que también se puede entrar como administrador
ADMIN_EMAIL=

# Correo saliente (Zoho)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# TPV simulado (marca reservas como pagadas sin cobrar). Solo "true" en local o pruebas, nunca en producción.
ENABLE_TEST_PAYMENTS=false

# Redsys (TPV). Sin MERCHANT_CODE y SECRET_KEY la pasarela queda desactivada.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_CURRENCY=978
REDSYS_SECRET_KEY=
REDSYS_URL=https://sis-t.redsys.es:25443/sis/realizarPago
